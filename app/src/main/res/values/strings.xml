    <!-- Settings menu: what each line does -->
    <string name="about_queue_off">One large cover beside the title.</string>
    <string name="about_queue_list">The next tracks as a list beside the cover.</string>
    <string name="about_queue_list_set_up">The next tracks as a list beside the cover. It needs Music Assistant: without it, the last line names only the next track.</string>
    <string name="about_queue_flow">The cover in the middle, earlier ones on the left, the next ones on the right. They turn when a new album starts.</string>
    <string name="about_appearance_auto">Light by day, dark from sunset to sunrise, by the sun’s position in Home Assistant.</string>
    <string name="about_appearance_light">Always light: a light background, dark type.</string>
    <string name="about_appearance_dark">Always dark: a dark background, light type.</string>
    <string name="about_clock">The time in the top line.</string>
    <string name="about_progress">The bar with the time played and the length. Turned off, a key press still shows it briefly.</string>
    <string name="about_next">The next track in the queue, in the last line.</string>
    <string name="about_album">The album’s name and year below the artists.</string>
    <string name="about_group">When other speakers play along, the time is followed by “Living room + 5” or “Everywhere”.</string>
    <string name="about_volume_on_change">When the volume changes, it shows next to the clock for a few seconds.</string>
    <string name="about_volume_always">The volume always shows next to the clock.</string>
    <string name="about_volume_off">The volume never shows.</string>
    <string name="about_values_set_up">Values from Home Assistant next to the time, like the outside temperature. OK shows the QR code; choose them on your phone.</string>
    <string name="about_values_on">Your values from Home Assistant stand next to the time. You change them on your phone, through Home Assistant below.</string>
    <string name="about_values_off">Your values from Home Assistant stay hidden. Right shows them next to the time.</string>
    <string name="about_lyrics_on">The words of the song beside the cover, the line being sung in the middle.</string>
    <string name="about_lyrics_off">Title, artist and album beside the cover. Right shows the words where Music Assistant has them.</string>
    <string name="about_lyrics_set_up">The words come from Music Assistant. OK shows the QR code to set it up on your phone.</string>
    <string name="about_background_cover">The cover’s colors fill the whole screen in soft gradients. The progress bar takes their hue.</string>
    <string name="about_background_plain">A calm background: dark with the cover’s light, or light with its shadow.</string>
    <string name="about_intensity_cover">How strongly the cover’s colors tint the background.</string>
    <string name="about_intensity_cover_strong">Strong: rich colors.</string>
    <string name="about_intensity_cover_normal">Normal is how Klangbild is meant to look.</string>
    <string name="about_intensity_cover_low">Low: muted colors.</string>
    <string name="about_intensity_cover_off_light">Off: almost no color.</string>
    <string name="about_intensity_cover_off_dark">Off: only the cover on black.</string>
    <string name="about_intensity_light">How much of the cover’s color the light background takes.</string>
    <string name="about_intensity_light_strong">Strong: a clear tint.</string>
    <string name="about_intensity_light_normal">Normal is how Klangbild is meant to look.</string>
    <string name="about_intensity_light_low">Low: only a hint.</string>
    <string name="about_intensity_light_off">Off: no color.</string>
    <string name="about_intensity_dark">How brightly the cover lights the background around it.</string>
    <string name="about_intensity_dark_strong">Strong suits bright rooms.</string>
    <string name="about_intensity_dark_normal">Normal is how Klangbild is meant to look.</string>
    <string name="about_intensity_dark_low">Low suits dark evenings.</string>
    <string name="about_intensity_dark_off">Off: only the cover, no light.</string>
    <string name="about_motion_both">How fast the colors in the background and in the lights flow.</string>
    <string name="about_motion_lights">How fast the lights’ colors flow. On screen, only with cover colors.</string>
    <string name="about_motion_screen">How fast the cover colors flow in the background.</string>
    <string name="about_motion_off">Off: they stand still.</string>
    <string name="about_motion_slow">Slow: barely noticeable.</string>
    <string name="about_motion_medium">Medium: clear, but calm.</string>
    <string name="about_motion_fast">Fast: visibly moving.</string>
    <string name="about_motion_playing">Only while music plays.</string>
    <string name="about_lights_set_up">Your lights glow in the cover’s colors. OK shows the QR code; on your phone you choose them from Home Assistant.</string>
    <string name="about_lights_off">The lights keep their own light. Right switches them on.</string>
    <string name="about_lights_only_on">Lights that are off stay off. One you switch on joins in.</string>
    <string name="about_lights_switch_on">Lights that are off go on with the music and off again after it.</string>
    <string name="about_lights_on">Each light glows in one of the picture’s colors, this bright by day. In the evening and at night they dim by themselves. After the music they are as before.</string>
    <string name="about_landscape_pause_off">When the music is paused, the cover stays; after three minutes the clock appears.</string>
    <string name="about_landscape_pause">When the music is paused this long, a paper landscape appears whose light follows the real time of day. Any key brings the cover back.</string>
    <string name="about_landscape_playing_off_volume">While music plays, the cover stays.</string>
    <string name="about_landscape_playing_off">While music plays, the cover stays. The landscape is always there: arrow up.</string>
    <string name="about_landscape_playing">If music plays this long with no key pressed, the landscape comes with the mini player in a corner.</string>
    <string name="about_mini_player_left">Cover, title and progress, lower left in the landscape.</string>
    <string name="about_mini_player_right">Cover, title and progress, lower right in the landscape.</string>
    <string name="about_mini_player_off">Just the landscape, no player.</string>
    <string name="about_remote_on">OK pauses and plays on; left and right change the track.</string>
    <string name="about_remote_off">The remote does not control the music; holding OK still opens this menu.</string>
    <string name="about_up_down_volume">Arrow up and down change the speaker’s volume; the quick settings are not available then.</string>
    <string name="about_up_down_landscape">Arrow up shows the landscape; up again or Back brings the cover back. Arrow down opens the quick settings at the bottom; down again closes them.</string>
    <string name="about_spoken_jump">With audiobooks and podcasts, left jumps back 15 seconds, right ahead 30 seconds. Held, they go to the previous or next chapter.</string>
    <string name="about_spoken_change">Left and right change the track with audiobooks and podcasts too.</string>
    <string name="about_sleep_timer_off">Pauses the music after a while, or at the end of a chapter. Klangbild must be running.</string>
    <string name="about_sleep_timer_at">The music pauses at %s.</string>
    <string name="about_sleep_timer_end">The music pauses at the %s.</string>
    <string name="sleep_end_chapter">end of the chapter</string>
    <string name="sleep_end_episode">end of the episode</string>
    <string name="sleep_end_book">end of the audiobook</string>
    <string name="sleep_end_track">end of the track</string>
    <string name="about_sleep_after">When no music plays, Klangbild turns off after this time.</string>
    <string name="about_sleep_action_close">Klangbild closes and returns to the home screen.</string>
    <string name="about_sleep_action_release">The TV takes over: its screen saver or standby.</string>
    <string name="about_connection_set_up">OK shows the QR code. On your phone you sign in to Home Assistant and choose the speaker.</string>
    <string name="about_connection">OK shows the QR code. On your phone you change address, sign-in and speaker.</string>
    <string name="about_ma_set_up">Optional. With Music Assistant, the list shows the next tracks, Cover Flow the whole queue, and audiobooks show their chapters. OK shows the QR code for setup.</string>
    <string name="about_ma">The list shows the next tracks, Cover Flow the whole queue. OK shows the QR code. On your phone you change address and token.</string>
    <string name="about_language">The language of the screens and the setup page. The system language is the TV’s.</string>

