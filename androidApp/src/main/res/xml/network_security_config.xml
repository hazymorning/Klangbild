<?xml version="1.0" encoding="utf-8"?>
<!--
  Home Assistant usually runs on plain http:// inside the home network. Android cannot
  express IP ranges here, so cleartext is permitted at the platform level and narrowed down
  in code: CleartextGuard lets an http:// request through only when the address
  it connected to is in the local network (private, link-local or loopback addresses).
  Everything else must use https:// with the system's trust store.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Cleartext is narrowed down in code, see above. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
